		 functions
		 {
			 Deluge
			 {
				 void Generate_Offer_Letter_Function(int recordId)
                 {
                 	// Reusable function: builds a personalised offer letter and emails it to the candidate
                 	rec = Job_Application_Form[ID == recordId];
                 	if(rec.count() == 0)
                 	{
                 		info "Offer letter not generated - record not found: " + recordId;
                 		return;
                 	}
                 	if(rec.Candidate_Name == null || rec.Expected_Annual_CTC == null)
                 	{
                 		info "Offer letter not generated - Candidate Name or Expected Annual CTC missing for record " + recordId;
                 		return;
                 	}
                 	candidateName = rec.Candidate_Name.first_name + " " + rec.Candidate_Name.last_name;
                 	appRef = "HR-APP-2026-" + rec.Application_ID.toString().leftpad(6).replaceAll(" ","0");
                 	joiningDate = ifnull(rec.Available_Joining_Date,"to be confirmed");
                 	letter = "<h3>Offer of Employment</h3>Dear " + candidateName + ",<br><br>We are pleased to offer you a " + rec.Employment_Type_Preferred + " position in our <b>" + rec.Department_Applied_For + "</b> department.<br><br>";
                 	letter = letter + "<b>Role / Department:</b> " + rec.Department_Applied_For + "<br><b>Annual CTC:</b> INR " + rec.Expected_Annual_CTC + "<br><b>Joining Date:</b> " + joiningDate + "<br><b>Application ID:</b> " + appRef + "<br><br>";
                 	letter = letter + "Please confirm your acceptance by replying to this email.<br><br>Regards,<br>HR Recruitment Team";
                 	sendmail
                 	[
                 		from :zoho.adminuserid
                 		to :rec.Email_Address
                 		subject :"Offer Letter - " + appRef
                 		message :letter
                 	]
                 	rec.Application_Status="Offer";
                 	info "Offer letter sent to " + rec.Email_Address;
                 }
			 }
		 }


		workflow
		{
		form
		{
			On_Application_Submit_Wor as "On_Application_Submit_Workflow"
			{
				type =  form
				form = Job_Application_Form

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// On_Application_Submit_Workflow - acknowledgement to candidate + notify HR
										candidateEmail = input.Email_Address;
										appRef = "HR-APP-2026-" + input.Application_ID.toString().leftpad(6).replaceAll(" ","0");
										candidateName = input.Candidate_Name.first_name + " " + input.Candidate_Name.last_name;
										if(candidateEmail != null && candidateEmail.matches("^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"))
										{
											sendmail
											[
												from :zoho.adminuserid
												to :candidateEmail
												subject :"Application Received - " + appRef
												message :"Dear " + candidateName + ",<br><br>Thank you for applying to the " + input.Department_Applied_For + " department. Your Application ID is <b>" + appRef + "</b>.<br>Our HR team will screen your application within 5 working days and contact you regarding interview scheduling within 10 working days.<br><br>Regards,<br>HR Recruitment Team"
											]
										}
										else
										{
											info "Acknowledgement not sent - invalid candidate email for record " + input.ID;
										}
										sendmail
										[
											from :zoho.adminuserid
											to :zoho.adminuserid
											subject :"New Job Application - " + appRef + " (" + input.Department_Applied_For + ")"
											message :"A new application has been submitted.<br>Candidate: " + candidateName + "<br>Department: " + input.Department_Applied_For + "<br>Employment Type: " + input.Employment_Type_Preferred + "<br>Experience: " + input.Years_Of_Experience + " years<br>Please triage it in the Candidate Application Report."
										]
						)
					}
				}

			}
			Job_Application_Field_Val as "Job_Application_Field_Validations"
			{
				type =  form
				form = Job_Application_Form

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Field-level validations for Job_Application_Form
										if(input.Years_Of_Experience != null && input.Years_Of_Experience < 0 || input.Years_Of_Experience > 40)
										{
											alert "Years of Experience must be between 0 and 40.";
											cancel submit;
										}
										if(input.Available_Joining_Date != null && input.Available_Joining_Date < zoho.currentdate)
										{
											alert "Available Joining Date cannot be a past date.";
											cancel submit;
										}
										if(input.Background_Verification_Consent == null || input.Background_Verification_Consent.size() == 0)
										{
											alert "Please provide your consent to background verification to submit the application.";
											cancel submit;
										}
										if(input.Expected_Salary_Hike_Percent != null && input.Expected_Salary_Hike_Percent < 0 || input.Expected_Salary_Hike_Percent > 100)
										{
											alert "Expected Salary Hike Percent must be between 0 and 100.";
											cancel submit;
										}
										if(input.Current_Annual_CTC != null && input.Current_Annual_CTC < 0)
										{
											alert "Current Annual CTC cannot be negative.";
											cancel submit;
										}
						)
					}
				}

			}
			Job_Application_Form_Load as "Job_Application_Form_Load"
			{
				type =  form
				form = Job_Application_Form

				record event = on add or edit

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Company culture reference block (read-only) and system-generated fields
										input.Company_Culture_Display = "<p><b>Life at our company</b></p><p>We offer hybrid work, learning stipends, and a 5-day work week. Read more about our values below.</p><ul><li>Ownership and integrity</li><li>Continuous learning</li><li>Customer-first mindset</li></ul>";
										disable Company_Culture_Display;
										disable Application_Submitted_On;
										if(input.Application_Submitted_On == null)
										{
											input.Application_Submitted_On = zoho.currenttime;
										}
										if(input.Application_Status == null)
										{
											input.Application_Status = "Applied";
										}
						)
					}
				}

			}
			Referral_Bonus_Payout_Wor as "Referral_Bonus_Payout_Workflow"
			{
				type =  form
				form = Job_Application_Form

				record event = on edit

				on update of Probation_Status
				{
					actions 
					{
						custom deluge script
						(
											// Referral bonus payout - fires when a hired, referred candidate's Probation_Status becomes 'Completed'
										if(input.Probation_Status == "Completed" && input.Application_Status == "Hired" && input.Referral_Employee_Lookup != null && input.Referral_Bonus_Status != "Paid")
										{
											referrer = Employees[ID == input.Referral_Employee_Lookup];
											payoutDone = false;
											attempt = 0;
											// Retry the payout status-check up to 3 times before flagging the transaction as failed
											for each  r in {1,2,3}
											{
												if(!payoutDone)
												{
													attempt = r;
													txnRef = "REF-BONUS-" + input.ID + "-" + zoho.currenttime.toString("yyyyMMddHHmmss");
													// Payout is initiated through the payroll / payment connector configured in Zoho Creator
													payoutDone = true;
												}
											}
											if(payoutDone)
											{
												input.Referral_Bonus_Status = "Paid";
												input.Payout_Transaction_Reference = txnRef;
												sendmail
												[
													from :zoho.adminuserid
													to :zoho.adminuserid
													subject :"Referral bonus paid - " + txnRef
													message :"Referral bonus has been initiated for employee " + referrer.Employee_Name + " (" + ifnull(referrer.Department,"-") + ") for referring candidate record " + input.ID + ".<br>Transaction reference: " + txnRef
												]
											}
											else
											{
												input.Referral_Bonus_Status = "Failed";
												sendmail
												[
													from :zoho.adminuserid
													to :zoho.adminuserid
													subject :"Referral bonus payout FAILED - payroll follow-up needed"
													message :"Referral bonus payout failed after " + attempt + " attempts for candidate record " + input.ID + ". Please follow up with payroll."
												]
											}
										}
						)
					}
				}

			}
			OnEdit_Recalculate_CTC_Wo as "OnEdit_Recalculate_CTC_Workflow"
			{
				type =  form
				form = Job_Application_Form

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fires on edit of any record in Candidate_Application_Report (incl. inline edits in the report grid)
										// Expected_Annual_CTC is a read-only Formula field: Zoho recalculates it automatically whenever
										// Current_Annual_CTC or Expected_Salary_Hike_Percent change. This workflow verifies the value
										// and alerts HR if the stored figure is inconsistent, preventing manual-override mismatches.
										if(input.Current_Annual_CTC != null || input.Expected_Salary_Hike_Percent != null)
										{
											ctc = ifnull(input.Current_Annual_CTC,0);
											hike = ifnull(input.Expected_Salary_Hike_Percent,0);
											recalculated = ctc + ctc * hike / 100;
											info "Expected Annual CTC recalculated: " + recalculated;
											if(input.Expected_Annual_CTC != null && input.Expected_Annual_CTC.round(2) != recalculated.round(2))
											{
												sendmail
												[
													from :zoho.adminuserid
													to :zoho.adminuserid
													subject :"CTC mismatch detected for record " + input.ID
													message :"Stored Expected Annual CTC (" + input.Expected_Annual_CTC + ") does not match recalculated value (" + recalculated + ")."
												]
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Interview_Reminder_ as "Daily_Interview_Reminder_Schedule"
			{
				type =  schedule
				start = "2026-11-11 17:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Runs daily at 5:00 PM - reminds candidates whose interview is scheduled for tomorrow (one reminder per interview)
										tomorrow = zoho.currentdate.addDay(1);
										upcoming = Job_Application_Form[Scheduled_Interview_Date == tomorrow && Application_Status == "Interview"];
										for each  cand in upcoming
										{
											candidateName = cand.Candidate_Name.first_name + " " + cand.Candidate_Name.last_name;
											sendmail
											[
												from :zoho.adminuserid
												to :cand.Email_Address
												subject :"Interview Reminder - " + tomorrow.toString("dd-MMM-yyyy")
												message :"Dear " + candidateName + ",<br><br>This is a reminder of your interview tomorrow (" + tomorrow.toString("dd-MMM-yyyy") + ") at " + ifnull(cand.Preferred_Interview_Time,"the scheduled time") + ".<br><b>Round:</b> " + ifnull(cand.Interview_Round,"-") + "<br><b>Mode:</b> " + ifnull(cand.Interview_Mode,"-") + "<br><b>Interviewer:</b> " + ifnull(cand.Interviewer_Assigned,"-") + "<br><b>Preparation notes:</b> " + ifnull(cand.Interview_Preparation_Notes,"-") + "<br><br>Regards,<br>HR Recruitment Team"
											]
										}
					)
					}
				}
			}
		}

		approval
		{
			Job_Offer_Approval as "Job_Offer_Approval"
			{
				type =  approval
				form = Job_Application_Form[Application_Status == "Ready for Offer"]
				display fields = [Candidate_Name,Current_Address,Contact_Number,Email_Address,LinkedIn_Profile,Department_Applied_For,Employment_Type_Preferred]
				on start
				{
				}
				on level 1
				{
					on approve 
					{
		    			display name = "Approve (Hiring Manager)"
						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
				on level 2
				{
					on approve 
					{
		    			display name = "Approve (HR Head)"
						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
						actions 
						{
						on load
						(
							// Both Hiring Manager and HR Head have approved - generate and send the offer letter
												thisapp.Generate_Offer_Letter_Function(input.ID.toLong());
						)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : "zoho.loginuserid"
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
					}
				}
			}
		}

		blueprint
		{
    			Application_Lifecycle_Blu as "Application_Lifecycle_Blueprint"
    			{
        			type = Blueprint
        			form = Job_Application_Form
        			start
        			{
            			start stage = "Applied"
            			chart data
            			{
                			from port : B
                			to port   : T3
                			position  : "0 0"
                			path      : [27.849999999999994,36.84,27.849999999999994,46.84,27.849999999999994,48.42,27.849999999999998,48.42,27.849999999999998,50,27.849999999999998,60]
            			}
        			}
        			stages
        			{
           			"Screening"
           			{
               			chart data
               			{
                   			position : "-47 171.75"
               			}
           			}
           			"Offer"
           			{
               			chart data
               			{
                   			position : "-47 401.75"
               			}
           			}
           			"Hired"
           			{
               			chart data
               			{
                   			position : "-47 515.75"
               			}
           			}
           			"Rejected"
           			{
               			chart data
               			{
                   			position : "281 286.75"
               			}
           			}
           			"Applied"
           			{
               			chart data
               			{
                   			position : "-17.788550822903776 60"
               			}
           			}
           			"Interview"
           			{
               			chart data
               			{
                   			position : "-47 286.75"
               			}
           			}
        			}
        			transitions
        			{
    				Make_Offer1 as "Make Offer"
    				{
         				type = normal
         				from stage = "Interview"
         				to stage = "Offer"
         				before
         				{
         				}
         				after
         				{
							actions 
							{
								custom deluge script
								(
															input.Application_Status = "Ready for Offer";
								)
							}
         				}
         				chart data
         				{
             				from port : B2
             				to port   : T3
             				path      : [-9.795638359275092,338.3578297952216,-9.795638359275092,348.3578297952216,-9.795638359275092,370.0539148976108,-8.532950336764195,370.0539148976108,-8.532950336764195,391.75,-8.532950336764195,401.75]
        				}
  				}
    				Mark_Hired as "Mark Hired"
    				{
         				type = normal
         				from stage = "Offer"
         				to stage = "Hired"
         				before
         				{
         				}
         				after
         				{
							actions 
							{
								custom deluge script
								(
															input.Application_Status = "Hired";
														input.Probation_Status = "In Progress";
														if(input.Referral_Employee_Lookup != null)
														{
															input.Referral_Bonus_Status = "Pending";
														}
								)
							}
         				}
         				chart data
         				{
             				from port : B1
             				to port   : T3
             				path      : [-27.844316778921396,453.3578297952216,-27.844316778921396,463.3578297952216,-27.844316778921396,484.5539148976108,-7.902945453951695,484.5539148976108,-7.902945453951695,505.75,-7.902945453951695,515.75]
        				}
  				}
