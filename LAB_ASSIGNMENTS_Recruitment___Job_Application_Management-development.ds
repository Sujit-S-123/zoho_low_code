 * Author       : sujit.s.2024.cse_rajalaks896
 * Generated on : 10-Nov-2026 22:59:04
 * Version      : 1.0
 */
 application "Recruitment & Job Application Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Employees
		{
			success message = "Employee Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Employee_Name
			(
    			type = name
				displayname = "Employee Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Department
			(
				type = picklist
				maxchar = 100
				values = {"Software Development","Engineering","Human Resources"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Employee_Email
			(
    			type = email
				displayname = "Employee Email"
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Job_Application_Form
		{
			displayname = "Job Application Form"
			success message = "Job Application Added Successfully"
			Section_A_Personal_Details
			(
				type = section
				displayname = "Section A - Personal Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Candidate_Name
			(
    			type = name
				displayname = "Candidate Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Current_Address
			(
    			type = address
				displayname = "Current Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
				displayname = "Contact Number"
    			defaultcountry="in"
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Section_B_Contact_Online_Presence
			(
				type = section
				displayname = "Section B - Contact & Online Presence"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			must have Email_Address
			(
    			type = email
				displayname = "Email Address"
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			LinkedIn_Profile
			(
    			type = text
				displayname = "LinkedIn Profile"
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section_C_Job_Experience_Details1
			(
				type = section
				displayname = "Section C - Job & Experience Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Department_Applied_For
			(
				type = picklist
				displayname = "Department Applied For"
				maxchar = 100
				values = {"Software Development","Engineering","Quality Assurance","Human Resources","Marketing","Finance"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Employment_Type_Preferred
			(
				type = radiobuttons
				displayname = "Employment Type Preferred"
				maxchar = 100
				values = {"Full-Time","Part-Time","Internship"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Years_Of_Experience
			(
				type = number
				displayname = "Years Of Experience"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Key_Skills
			(
				type = list	
				displayname = "Key Skills"
				values = {"Java","React","SQL","Communication","Python"}
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Available_Joining_Date
			(
    			type = date
				displayname = "Available Joining Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section_D
			(
				type = section
				displayname = "Section D - Interview Scheduling & Consent"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			Preferred_Interview_Time
			(
    			type = time
				displayname = "Preferred Interview Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 4
	 			column = 1   
				width = medium
			)
			Cover_Letter
			(
    			type = textarea
				displayname = "Cover Letter"
				height = 100px
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Background_Verification_Consent
			(
				type = checkboxes	
				displayname = "Background Verification Consent"
				values = {"I consent to background verification if selected"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Section_E_Academic_Referral_Verification
			(
				type = section
				displayname = "Section E - Academic & Referral Verification"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Referral_Employee_Lookup
			(
				type = picklist	
				displayname = "Referral Employee Lookup"
				values  = Employees.ID
    			displayformat = [" " + Employee_Name.prefix + " " + Employee_Name.first_name + " " + Employee_Name.last_name + " " + Employee_Name.suffix]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Candidate_Photo
			(
    			type = image
				displayname = "Candidate Photo"
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			Resume_Upload
			(
    			type = upload file
				displayname = "Resume Upload"
				browse = local_drive
				allowed file formats = {"pdf","docx"}
	 			row = 5
	 			column = 1   
				width = medium
			)
			Academic_CGPA
			(
				type = decimal
				displayname = "Academic CGPA"
	 			row = 5
	 			column = 1   
				width = medium
			)
			Section_F_Employment_History_Media_Details
			(
				type = section
				displayname = "Section F - Employment History & Media Details"
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Portfolio_GitHub_URL
			(
    			type = url
				displayname = "Portfolio GitHub URL"
				enable  linkname
	 			row = 6
	 			column = 1   
				width = medium
			)
			Video_Resume
			(
    			type = video
				displayname = "Video Resume"
    			duration=90
	 			row = 6
	 			column = 1   
				width = medium
			)
			Self_Introduction_Audio
			(
     			type = audio
				displayname = "Self Introduction Audio"
    			duration=60
	 			row = 6
	 			column = 1   
				width = medium
			)
			Previous_Employment_History
			(
				type = grid
				displayname = "Previous Employment History"
				maxrow = 6
				Company_Name
				(
    				type = text
					displayname = "Company Name"
					width = medium
				)
				Designation
				(
    				type = text
					width = medium
				)
				Duration_Years
				(
					type = decimal
					displayname = "Duration (Years)"
					width = medium
				)
	 			row = 7
	 			column = 1   
				width = medium
			)
			Section_G_Compensation_Relocation
			(
				type = section
				displayname = "Section G - Compensation & Relocation"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			must have Willing_To_Relocate
			(
    			type = checkbox
				displayname = "Willing To Relocate"
				initial value = false
	 			row = 8
	 			column = 1   
				width = medium
			)
			Current_Annual_CTC
			(
				displayname = "Current Annual CTC"
				type = INR
				format = commadotindian
	 			row = 8
	 			column = 1   
				width = medium
			)
			Expected_Salary_Hike_Percent
			(
    			type = percentage
				displayname = "Expected Salary Hike Percent"
	 			row = 8
	 			column = 1   
				width = medium
			)
			Expected_Annual_CTC
			(
				type = decimal
				displayname = "Expected Annual CTC"
	 			row = 8
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Current_Annual_CTC + input.Current_Annual_CTC * input.Expected_Salary_Hike_Percent / 100
    						visibility = true
    			)
			)
			Section_H_Declaration_System_Generated_Values
			(
				type = section
				displayname = "Section H - Declaration & System-Generated Values"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Company_Culture_Display
			(
    			type = richtext
				displayname = "Company Culture Display"
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 9
	 			column = 1   
				width = medium
			)
			must have Candidate_Digital_Signature
			(
    			type = signature
				displayname = "Candidate Digital Signature"
	 			row = 9
	 			column = 1   
				width = medium
				personal data = true
			)
			Application_Submitted_On
			(
    			type = datetime
				displayname = "Application Submitted On"
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 9
	 			column = 1   
				width = medium
			)
			Application_ID
			(
    			type = autonumber
				displayname = "Application ID"
				start index = 1
	 			row = 9
	 			column = 1   
				width = medium
			)
			Candidate_Tracking_QR_Code
			(
				type = qrcode
				displayname = "Candidate Tracking QR Code"
				value = "HR-APP-2026-${Application_ID}"
	 			row = 9
	 			column = 1   
				width = medium
			)
			Section_I_HR_Processing_Internal
			(
				type = section
				displayname = "Section I - HR Processing (Internal)"
				visibility = true
	 			row = 10
	 			column = 0   
				width = medium
			)
			Application_Status
			(
				type = picklist
				displayname = "Application Status"
				maxchar = 100
				values = {"Applied","Screening","Interview","Ready for Offer","Offer","Hired","Rejected"}
				initial value = "Applied"
	 			row = 10
	 			column = 1   
				width = medium
			)
			Screening_Status
			(
				type = picklist
				displayname = "Screening Status"
				maxchar = 100
				values = {"Pending","Shortlisted","On Hold","Not Shortlisted"}
	 			row = 10
	 			column = 1   
				width = medium
			)
			Interview_Round
			(
				type = picklist
				displayname = "Interview Round"
				maxchar = 100
				values = {"Round 1 - Technical","Round 2 - Managerial","Round 3 - HR"}
	 			row = 10
	 			column = 1   
				width = medium
			)
			Interviewer_Assigned
			(
    			type = text
				displayname = "Interviewer Assigned"
	 			row = 10
	 			column = 1   
				width = medium
			)
			Scheduled_Interview_Date
			(
    			type = date
				displayname = "Scheduled Interview Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 10
	 			column = 1   
				width = medium
			)
			Probation_Status
			(
				type = picklist
				displayname = "Probation Status"
				maxchar = 100
				values = {"Not Applicable","In Progress","Completed"}
	 			row = 10
	 			column = 1   
				width = medium
			)
			Interview_Preparation_Notes
			(
    			type = textarea
				displayname = "Interview Preparation Notes"
				height = 100px
	 			row = 10
	 			column = 1   
				width = medium
			)
			Payout_Transaction_Reference
			(
    			type = text
				displayname = "Payout Transaction Reference"
	 			row = 10
	 			column = 1   
				width = medium
			)
			Referral_Bonus_Status
			(
				type = picklist
				displayname = "Referral Bonus Status"
				maxchar = 100
				values = {"Not Applicable","Pending","Paid","Failed"}
	 			row = 10
	 			column = 1   
				width = medium
			)
			Interview_Mode
			(
				type = radiobuttons
				displayname = "Interview Mode"
				maxchar = 100
				values = {"In-person","Virtual"}
	 			row = 10
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Stage1","Stage2","Stage3","Screening","Offer","Hired","Rejected","Applied","Interview"}
			}
		}
	}
	reports
	{
		default list All_Job_Applications
		{
			displayName = "All Job Applications"
			show all rows from Job_Application_Form    
			(
				Candidate_Name  as "Candidate Name"
				Current_Address  as "Current Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Email_Address as "Email Address"
				LinkedIn_Profile as "LinkedIn Profile"
				Department_Applied_For as "Department Applied For"
				Employment_Type_Preferred as "Employment Type Preferred"
				Years_Of_Experience as "Years Of Experience"
				Key_Skills as "Key Skills"
				Available_Joining_Date as "Available Joining Date"
				Preferred_Interview_Time as "Preferred Interview Time"
				Cover_Letter as "Cover Letter"
				Background_Verification_Consent as "Background Verification Consent"
				Academic_CGPA as "Academic CGPA"
				Resume_Upload as "Resume Upload"
				Candidate_Photo as "Candidate Photo"
				Portfolio_GitHub_URL as "Portfolio GitHub URL"
				Previous_Employment_History.Company_Name as "Previous Employment History"
				Video_Resume as "Video Resume"
				Self_Introduction_Audio as "Self Introduction Audio"
				Current_Annual_CTC as "Current Annual CTC"
				Expected_Salary_Hike_Percent as "Expected Salary Hike Percent"
				Expected_Annual_CTC as "Expected Annual CTC"
				Willing_To_Relocate as "Willing To Relocate"
				Company_Culture_Display as "Company Culture Display"
				Candidate_Digital_Signature as "Candidate Digital Signature"
				Application_Submitted_On as "Application Submitted On"
				Application_ID as "Application ID"
				Candidate_Tracking_QR_Code as "Candidate Tracking QR Code"
				Referral_Employee_Lookup as "Referral Employee Lookup"
				Application_Status as "Application Status"
				Screening_Status as "Screening Status"
				Interview_Round as "Interview Round"
				Interviewer_Assigned as "Interviewer Assigned"
				Scheduled_Interview_Date as "Scheduled Interview Date"
				Interview_Mode as "Interview Mode"
				Probation_Status as "Probation Status"
				Referral_Bonus_Status as "Referral Bonus Status"
				Payout_Transaction_Reference as "Payout Transaction Reference"
				Interview_Preparation_Notes as "Interview Preparation Notes"
			)
		}
		default list All_Employees
		{
			displayName = "All Employees"
			show all rows from Employees    
			(
				Employee_Name  as "Employee Name"
				Department
				Employee_Email as "Employee Email"
			)
		}
		list All_Applications_List
		{
			displayName = "All_Applications_List"
			show all rows from Job_Application_Form    
			(
				Candidate_Name  as "Candidate Name"
				Current_Address  as "Current Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Email_Address as "Email Address"
				LinkedIn_Profile as "LinkedIn Profile"
				Department_Applied_For as "Department Applied For"
				Employment_Type_Preferred as "Employment Type Preferred"
				Years_Of_Experience as "Years Of Experience"
				Key_Skills as "Key Skills"
				Available_Joining_Date as "Available Joining Date"
				Preferred_Interview_Time as "Preferred Interview Time"
				Cover_Letter as "Cover Letter"
				Background_Verification_Consent as "Background Verification Consent"
				Referral_Employee_Lookup as "Referral Employee Lookup"
				Candidate_Photo as "Candidate Photo"
				Resume_Upload as "Resume Upload"
				Academic_CGPA as "Academic CGPA"
				Portfolio_GitHub_URL as "Portfolio GitHub URL"
				Video_Resume as "Video Resume"
				Self_Introduction_Audio as "Self Introduction Audio"
				Willing_To_Relocate as "Willing To Relocate"
				Current_Annual_CTC as "Current Annual CTC"
				Expected_Salary_Hike_Percent as "Expected Salary Hike Percent"
				Expected_Annual_CTC as "Expected Annual CTC"
				Company_Culture_Display as "Company Culture Display"
				Candidate_Digital_Signature as "Candidate Digital Signature"
				Application_Submitted_On as "Application Submitted On"
				Application_ID as "Application ID"
				Candidate_Tracking_QR_Code as "Candidate Tracking QR Code"
				Application_Status as "Application Status"
				Screening_Status as "Screening Status"
				Interview_Round as "Interview Round"
				Interviewer_Assigned as "Interviewer Assigned"
				Scheduled_Interview_Date as "Scheduled Interview Date"
				Probation_Status as "Probation Status"
				Interview_Preparation_Notes as "Interview Preparation Notes"
				Payout_Transaction_Reference as "Payout Transaction Reference"
				Referral_Bonus_Status as "Referral Bonus Status"
				Interview_Mode as "Interview Mode"
			)
			filters
			(
				Department_Applied_For
				Employment_Type_Preferred
				Application_Status
			)
			sort by
			(
				Application_Submitted_On descending
			)
		}
		spreadsheet Applications_Spreadsheet
		{
			displayName = "Applications_Spreadsheet"
			show all rows from Job_Application_Form    
			(
				Candidate_Name  as "Candidate Name"
				Current_Address  as "Current Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Contact_Number as "Contact Number"
				(
					displayformat = plainnumber 
				)
				Email_Address as "Email Address"
				LinkedIn_Profile as "LinkedIn Profile"
				Department_Applied_For as "Department Applied For"
				Employment_Type_Preferred as "Employment Type Preferred"
				Years_Of_Experience as "Years Of Experience"
				Key_Skills as "Key Skills"
				Available_Joining_Date as "Available Joining Date"
				Preferred_Interview_Time as "Preferred Interview Time"
				Cover_Letter as "Cover Letter"
				Background_Verification_Consent as "Background Verification Consent"
				Referral_Employee_Lookup as "Referral Employee Lookup"
				Candidate_Photo as "Candidate Photo"
				Resume_Upload as "Resume Upload"
				Academic_CGPA as "Academic CGPA"
				Portfolio_GitHub_URL as "Portfolio GitHub URL"
				Video_Resume as "Video Resume"
				Self_Introduction_Audio as "Self Introduction Audio"
				Willing_To_Relocate as "Willing To Relocate"
				Current_Annual_CTC as "Current Annual CTC"
				Expected_Salary_Hike_Percent as "Expected Salary Hike Percent"
				Expected_Annual_CTC as "Expected Annual CTC"
				Company_Culture_Display as "Company Culture Display"
				Candidate_Digital_Signature as "Candidate Digital Signature"
				Application_Submitted_On as "Application Submitted On"
				Application_ID as "Application ID"
				Candidate_Tracking_QR_Code as "Candidate Tracking QR Code"
				Application_Status as "Application Status"
				Screening_Status as "Screening Status"
				Interview_Round as "Interview Round"
				Interviewer_Assigned as "Interviewer Assigned"
				Scheduled_Interview_Date as "Scheduled Interview Date"
				Probation_Status as "Probation Status"
