		menu
		{
			space Space
			{
				displayname = "Space"
				icon = "objects-spaceship"

				section Job_Applications
				{
					displayname = "Job Applications"
					icon = "users-2-a-time"
					form  Job_Application_Form
					{
						icon = "design-2-form"
					}
					report All_Job_Applications
					{
						icon = "tech-desktop"
					}
					report All_Applications_List
					{
						icon = "design-2-form"
					}
					report Applications_Spreadsheet
					{
						icon = "design-2-form"
					}
					report Application_Status_Kanban
					{
						icon = "design-2-form"
					}
					report Interview_Schedule_Calendar
					{
						icon = "design-2-form"
					}
					report Candidate_Location_Map
					{
						icon = "design-2-form"
					}
					report Application_Activity_Timeline
					{
						icon = "design-2-form"
					}
				}
				section ZC_App_Preferences
				{
					displayname = "App Preferences"
					icon = "design-app"
					systemcomponent
					{
						type = localization
						displayname = "Language Selection"
						icon = "education-language"
					}
					systemcomponent
					{
						type = connection
						displayname = "Integrations"
						icon = "tech-2-connection"
					}
				}
				section ZC_Approvals
				{
					displayname = "Approvals"
					icon = "ui-2-hourglass"
					systemcomponent
					{
						type = approval
						approval status = pending
						displayname = "Pending Tasks"
						icon = "ui-2-hourglass"
					}
					systemcomponent
					{
						type = approval
						approval status = completed
						displayname = "Completed Tasks"
						icon = "design-todo"
					}
				}
				section SharedAnalytics_Section
				{
					type = shared_user_report_section
					displayname = "Reports"
					icon = "business-chart-bar-33"
				}
				section Employees
				{
					displayname = "Employees"
					icon = "users-single-04"
					form  Employees
					{
						icon = "users-single-04"
					}
					report All_Employees
					{
						icon = "tech-desktop"
					}
				}
			}
			preference
			{
				icon
				{
					style = outline
				}
			}
		}
		customize
		{
			font = "lato"
			color options
			{
				color = "11"
			}
			logo
			{
				preference = "app_icon"
				placement = "left"
			}
		}
	}
	phone
	{
		customize
		{
			layout = twocolumn
			font = "default"
			style = "3"
			color options
			{
				color = chryslerpurple
			}
			logo
			{
				preference = "none"
			}
		}
	}
	tablet
	{
		customize
		{
			layout = slidingpane
			font = "default"
			style = "3"
			color options
			{
				color = turquoise
			}
			logo
			{
				preference = "none"
			}
		}
	}
