		batchworkflow
		{
			Bulk_Rejection_Notificati
			{
    			display name = "Bulk_Rejection_Notification_Batch"
    			type = batchworkflow
    			form = Job_Application_Form[Application_Status == "Rejected"]
    			event = "On Schedule"
    			start = "10-Nov-2026 21:00:00"
    			frequency = daily
    			batch size = 100
    			status = active
    			on execute 
    			{
					actions 
					{
						custom deluge script
						(
											// Runs for each rejected record in the batch - only candidates rejected in the past 24 hours are notified
										if(input.Modified_Time >= zoho.currenttime.subHour(24))
										{
											candidateName = input.Candidate_Name.first_name + " " + input.Candidate_Name.last_name;
											sendmail
											[
												from :zoho.adminuserid
												to :input.Email_Address
												subject :"Update on your application for " + input.Department_Applied_For
												message :"Dear " + candidateName + ",<br><br>Thank you for the time and effort you invested in applying to the " + input.Department_Applied_For + " department. After careful consideration, we will not be moving forward with your application at this time.<br>We truly appreciate your interest and encourage you to apply for future openings that match your profile.<br><br>Warm regards,<br>HR Recruitment Team"
											]
										}
						)
					}
    			}
			}
		}

	}
